# Copia este archivo a .env para desarrollo local (npm run dev).
# Sin RESEND_API_KEY los correos no se envían: se guardan en data/outbox/.
RESEND_API_KEY=
MAIL_FROM="Blog de Jesús Flórez <newsletter@jesusflorez.cloud>"
MAIL_REPLY_TO=

PORT=3002
DATABASE_PATH=./data/newsletter.db
SITE_URL=http://localhost:5173
API_URL=http://localhost:5173/api/newsletter
FEED_URL=https://blog.jesusflorez.cloud/feed.json

# Opcionales (valores por defecto)
# DIGEST_CRON="0 8 * * *"
# DIGEST_WEEKDAY=1
# DIGEST_MAX_AGE_DAYS=14
# DAILY_EMAIL_LIMIT=100
# CONFIRMATION_RESERVE=15
